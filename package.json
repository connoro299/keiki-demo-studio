{
  "name": "imessage-demo-maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify:upstream": "tsx scripts/check-upstream.ts",
    "demo": "tsx src/cli/main.ts",
    "outreach": "tsx --env-file-if-exists=.env.local src/outreach/cli.ts",
    "x": "tsx --env-file-if-exists=.env.local src/outreach/x/cli.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "ffmpeg-static": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
