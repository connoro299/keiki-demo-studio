<?xml version="1.0" encoding="UTF-8"?>
<!-- Keeps `npm run bot` running on an always-on Mac. Edit the two paths, then:
     cp deploy/com.keiki.demo-bot.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.keiki.demo-bot.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.keiki.demo-bot</string>
  <key>WorkingDirectory</key><string>/Users/YOU/imessagedemo</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/bin/npm</string><string>run</string><string>bot</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/keiki-demo-bot.log</string>
  <key>StandardErrorPath</key><string>/tmp/keiki-demo-bot.log</string>
</dict>
</plist>
